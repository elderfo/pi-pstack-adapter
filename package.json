{
  "name": "pi-pstack-adapter",
  "version": "0.3.0",
  "description": "Run Cursor's official pstack plugin inside Pi from an unmodified upstream checkout",
  "type": "module",
  "license": "MIT",
  "author": "Chris 'Freddy' Getsfred (https://github.com/elderfo)",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "pstack",
    "cursor",
    "skills",
    "adapter"
  ],
  "homepage": "https://github.com/elderfo/pi-pstack-adapter#readme",
  "bugs": {
    "url": "https://github.com/elderfo/pi-pstack-adapter/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elderfo/pi-pstack-adapter.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": []
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "test:isolated": "bash test/isolated-install.sh"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.86.1",
    "@types/node": "^24.0.0",
    "typebox": "^1.3.34",
    "typescript": "^5.7.0"
  },
  "files": [
    "index.ts",
    "src",
    "adapter-skills",
    "README.md",
    "LICENSE",
    "docs",
    "VERSION",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "yaml": "^2.8.3"
  }
}
